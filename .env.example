# ==============================================================================
# HIDROREADER - CONFIGURAÇÃO DE AMBIENTE (PRODUÇÃO & DESENVOLVIMENTO)
# ==============================================================================

# 1. Inteligência Artificial: Provedor e Chaves de API
# Provedor padrão: "openai" (ChatGPT), "gemini" ou "hibrido" (dupla verificação com fallback)
PROVEDOR_IA="openai"

# API OpenAI (ChatGPT Vision - Recomendado: gpt-4o-mini ou gpt-4o)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY="sua_chave_openai_aqui"
OPENAI_MODEL="gpt-4o-mini"

# API Google Gemini Vision (Opcional ou para dupla verificação de contingência)
# Obtenha sua chave gratuita em https://aistudio.google.com/
GEMINI_API_KEY="sua_chave_gemini_aqui"
GEMINI_MODEL="gemini-2.5-flash"

# 2. Segurança e Autenticação JWT
# Chave secreta para assinar os tokens dos operadores (IMPORTANTE: altere em produção!)
SECRET_KEY="troque_por_uma_chave_secreta_longa_e_aleatoria_em_producao"
TOKEN_EXPIRE_HOURS=24

# Senhas padrão dos usuários iniciais (utilizadas apenas se o banco estiver vazio)
ADMIN_DEFAULT_PASSWORD="admin"
OPERATOR_DEFAULT_PASSWORD="123456"

# 3. Banco de Dados (Opcional - padrão: SQLite local hidroreader.db)
# Para deploy na nuvem com PostgreSQL (ex: Railway, Render, Supabase, Neon):
# DATABASE_URL="postgresql://usuario:senha@host:5432/nome_banco"
# DATABASE_URL="sqlite:///hidroreader.db"

# 4. Servidor e Rede
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"
ALLOWED_ORIGINS="*"
LOG_LEVEL="INFO"
